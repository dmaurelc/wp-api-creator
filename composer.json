{
  "name": "danielmc/wp-api-creator",
  "description": "Convert WordPress into a configurable custom API.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "WpApiCreator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WpApiCreator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "authors": [
    {
      "name": "Daniel Maurel",
      "email": "dmaurelc@gmail.com"
    }
  ]
}
