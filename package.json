{
  "name": "wp-api-creator",
  "version": "1.2.0",
  "description": "Dashboard SPA for WP Custom API Creator plugin.",
  "scripts": {
    "build": "wp-scripts build src/frontend/index.js --output-path=build",
    "start": "wp-scripts start src/frontend/index.js --output-path=build",
    "zip": "npm run build && git archive --format=zip --worktree-attributes -o wp-api-creator.zip HEAD"
  },
  "devDependencies": {
    "@wordpress/scripts": "^27.0.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.6",
    "sass": "^1.72.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^6.44.0",
    "@wordpress/components": "^27.3.0",
    "@wordpress/element": "^5.28.0",
    "@wordpress/i18n": "^4.47.0",
    "lodash": "^4.17.23"
  }
}
