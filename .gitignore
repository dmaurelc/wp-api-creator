# Dependencies
node_modules/
vendor/

# Build artifacts (keep compiled assets, exclude source maps)
build/*.map

# Environment files
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
.cache/

# Distribution ZIP (generated via npm run zip, attached to releases)
*.zip
